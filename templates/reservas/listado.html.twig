{% extends 'base.html.twig' %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %} 
    <h1>{{ titulo }}</h1> 

    <form id="filtros">
        <label>
            Estado
            <select name="estado">
                <option value="">Todos</option>
                <option value="pendiente">Pendiente</option>
                <option value="confirmada">Confirmada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </label>
        <label>
            Desde
            <input type="date" name="desde">
        </label>
        <label>
            Hasta
            <input type="date" name="hasta">
        </label>
        <label>
            Nombre Huesped
            <input type="search" name="q" maxlength="100">
        </label>
        <button type="submit">Filtrar</button>
        <button type="button" id="limpiar-filtros">Limpiar</button>
    </form>

    <p id="aviso-listado" role="status" aria-live="polite"></p>

    <div class="tabla-contenedor">
        <table>
            <thead>
                <tr>
                    <th>Huésped</th>
                    <th>Alojamiento</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Estado</th>
                    <th>Importe</th>
                    <th>Ver detalle</th>
                </tr>
            </thead>

            <tbody id="reservas-cuerpo">
                {% for reserva in reservas %}
                    <tr>
                        <td>{{ reserva.nombre_huesped }}</td>
                        <td>{{ reserva.nombre_alojamiento }}</td>
                        <td>{{ reserva.fecha_entrada|date('d/m/Y') }}</td>
                        <td>{{ reserva.fecha_salida|date('d/m/Y') }}</td>
                        <td><span class="estado estado--{{ reserva.estado }}">{{ reserva.estado|capitalize }}</span></td>
                        <td>{{ reserva.importe|number_format(2, ',', '.') }} €</td>
                        <td><a href="/reservas/{{ reserva.id }}">Ver detalle</a></td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">No hay reservas</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    
    <details>
        <summary>Nueva reserva</summary>

        <form id="form-crear">
            <label>
                Huésped
                <input type="text" name="nombre_huesped" required maxlength="100" aria-describedby="error-nombre_huesped">
            </label>
            <p class="error-campo" id="error-nombre_huesped"></p>
            <label>
                Email
                <input type="email" name="email_huesped" required maxlength="254" aria-describedby="error-email_huesped">
            </label>
            <p class="error-campo" id="error-email_huesped"></p>
            <label>
                Nombre de Alojamiento
                <input type="text" name="nombre_alojamiento" required maxlength="254" aria-describedby="error-nombre_alojamiento">
            </label>
            <p class="error-campo" id="error-nombre_alojamiento"></p>
            <label>
                Fecha de Entrada
                <input type="date" name="fecha_entrada" required min="{{ 'now'|date('Y-m-d') }}" aria-describedby="error-fecha_entrada">
            </label>
            <p class="error-campo" id="error-fecha_entrada"></p>
            <label>
                Fecha de Salida
                <input type="date" name="fecha_salida" required min="{{ 'now'|date('Y-m-d') }}" aria-describedby="error-fecha_salida">
            </label>
            <p class="error-campo" id="error-fecha_salida"></p>
            <label>
                Importe
                <input type="number" name="importe" required min="0" max="99999999.99" step="0.01" aria-describedby="error-importe">
            </label>
            <p class="error-campo" id="error-importe"></p>
            <label>
                notas
                <textarea name="notas" maxlength="1000" aria-describedby="error-notas"></textarea>
            </label>
            <p class="error-campo" id="error-notas"></p>
            <button type="submit">Crear reserva</button>
        </form>

        <p id="aviso-crear" role="status" aria-live="polite"></p>
    </details>

{% endblock %}

{% block scripts %}
    <script type="module" src="/js/listado.js"></script>
{% endblock %}
